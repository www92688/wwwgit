/* ============================================================
   统一主题模板（占位符由 theme.py 按 浅色/深色 渲染后应用；
   占位符形为「@ + 小写字母下划线」，渲染后不应残留未替换标记）
   ============================================================ */

* {
    font-family: "Microsoft YaHei UI", "PingFang SC", sans-serif;
    outline: none;
}
QWidget { font-size: 13px; color: @text; }

QMainWindow, QDialog { background: @page; }

/* ---------- 侧边导航 ---------- */
#navList {
    background: @nav_bg; color: @nav_text;
    border: none; outline: none;
    min-width: 172px; max-width: 188px;
    padding: 8px 0;
}
#navList::item {
    padding: 11px 18px; margin: 2px 10px;
    border-radius: 8px; color: @nav_text;
}
#navList::item:hover { background: @nav_hover; color: @nav_text_h; }
#navList::item:selected { background: @primary; color: #ffffff; }

#sideBar { background: @nav_bg; }
#sideTitle { color: #ffffff; font-size: 15px; font-weight: 600; }
#sideSub   { color: @nav_text; font-size: 11px; }
#sideVersion { color: @nav_text; font-size: 11px; }
#sideMark {
    background: @primary; color: white; border-radius: 7px;
    font-weight: 700; font-size: 14px;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background: @primary; color: #ffffff; border: none;
    border-radius: 6px; padding: 7px 20px;
    font-weight: 500;
    min-height: 18px;
}
QPushButton:hover { background: @primary_h; }
QPushButton:pressed { background: @primary_p; }
QPushButton:focus { background: @primary_h; }
QPushButton:disabled { background: @disabled_bg; color: @disabled_text; }

QPushButton#secondaryBtn { background: @secondary; color: @secondary_text; }
QPushButton#secondaryBtn:hover { background: @secondary_h; }
QPushButton#secondaryBtn:pressed { background: @secondary_p; }
QPushButton#secondaryBtn:focus { background: @secondary_h; }
QPushButton#secondaryBtn:disabled { background: @secondary; color: @text3; }

QPushButton#dangerBtn { background: #e03131; }
QPushButton#dangerBtn:hover { background: #c92a2a; }
QPushButton#dangerBtn:pressed { background: #b02525; }

/* ---------- 输入控件 ---------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    border: 1px solid @input_border; border-radius: 6px;
    padding: 6px 10px; background: @input_bg;
    color: @text;
    selection-background-color: @primary; selection-color: #ffffff;
    min-height: 18px;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: @input_border_h;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid @primary;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled { background: @secondary; color: @text3; }

QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @arrow;
    margin-right: 8px;
}
QComboBox::down-arrow:hover, QComboBox::down-arrow:on { border-top-color: @arrow_h; }
QComboBox QAbstractItemView {
    background: @menu_bg; border: 1px solid @border;
    color: @text;
    border-radius: 6px; padding: 4px;
    selection-background-color: @selected_bg; selection-color: @selected_text;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: transparent; border: none; width: 18px;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 0; height: 0; border-left: 4px solid transparent;
    border-right: 4px solid transparent; border-bottom: 4px solid @arrow;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 0; height: 0; border-left: 4px solid transparent;
    border-right: 4px solid transparent; border-top: 4px solid @arrow;
}

/* ---------- 勾选 / 单选 ---------- */
QCheckBox, QRadioButton { spacing: 7px; }
QCheckBox:disabled, QRadioButton:disabled { color: @text3; }

QCheckBox::indicator, QTreeView::indicator, QListView::indicator {
    width: 16px; height: 16px; border: 1px solid @indicator_border;
    border-radius: 4px; background: @input_bg;
}
QCheckBox::indicator:hover, QTreeView::indicator:hover, QListView::indicator:hover {
    border-color: @primary;
}
QCheckBox::indicator:checked, QTreeView::indicator:checked, QListView::indicator:checked {
    background-color: @primary; border-color: @primary;
}
QCheckBox::indicator:indeterminate, QTreeView::indicator:indeterminate {
    background-color: @indeterminate; border-color: @indeterminate;
}
QCheckBox::indicator:disabled, QTreeView::indicator:disabled {
    background: @secondary; border-color: @input_border;
}

QRadioButton::indicator {
    width: 16px; height: 16px; border: 1px solid @indicator_border;
    border-radius: 9px; background: @input_bg;
}
QRadioButton::indicator:hover { border-color: @primary; }
QRadioButton::indicator:checked { border: 5px solid @primary; background: @input_bg; }

/* ---------- 列表 / 表格 / 树 ---------- */
QTableWidget, QTableView, QTreeWidget, QListWidget, QTextBrowser {
    border: 1px solid @border; border-radius: 8px; background: @card;
    color: @text;
    alternate-background-color: @alt_row;
    selection-background-color: @selected_bg; selection-color: @selected_text;
}
QTreeView, QListWidget { padding: 4px; }

QListWidget::item { padding: 6px 8px; border-radius: 5px; }
QListWidget::item:hover { background: @hover; }
QListWidget::item:selected { background: @selected_bg; color: @selected_text; }

QTreeView::item, QTableView { selection-background-color: @selected_bg; }
QTreeView::item { padding: 4px 2px; border-radius: 4px; }
QTreeView::item:hover { background: @hover; }
QTreeView::item:selected { background: @selected_bg; color: @selected_text; }

QHeaderView::section {
    background: @header_bg; color: @text2;
    border: none; border-bottom: 1px solid @header_border;
    padding: 8px 10px; font-weight: 600;
}
QTableView { gridline-color: @grid_line; }

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent; width: 9px; margin: 2px;
}
QScrollBar::handle:vertical {
    background: @scrollbar; border-radius: 4px; min-height: 32px;
}
QScrollBar::handle:vertical:hover { background: @scrollbar_h; }
QScrollBar:horizontal {
    background: transparent; height: 9px; margin: 2px;
}
QScrollBar::handle:horizontal {
    background: @scrollbar; border-radius: 4px; min-width: 32px;
}
QScrollBar::handle:horizontal:hover { background: @scrollbar_h; }
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page { background: none; border: none; }
QScrollBarCorner { background: transparent; }

/* ---------- 进度条 ---------- */
QProgressBar {
    border: none; background: @progress_bg; border-radius: 5px;
    height: 10px; text-align: center;
    color: @progress_text; font-size: 11px;
}
QProgressBar::chunk { background: @primary; border-radius: 5px; }

/* ---------- 卡片 / 分组 ---------- */
QGroupBox {
    border: 1px solid @border; border-radius: 10px;
    margin-top: 16px; background: @card;
    padding: 6px 4px 8px 4px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin; left: 14px; top: 2px;
    padding: 0 6px; color: @text;
}

QLabel#cardTitle { font-weight: 600; }
QLabel#muted { color: @text3; font-size: 12px; background: transparent; }
QLabel#emptyTitle { color: @empty_title; font-size: 16px; background: transparent; }
QLabel#emptyHint { color: @empty_hint; font-size: 12px; background: transparent; }
QLabel#stepHint { color: @text2; padding: 2px 2px; background: transparent; }

/* 去重方案档位卡片：选中态由动态属性 checked 驱动 */
QWidget#presetCard {
    border: 1px solid @border; border-radius: 8px; background: @card;
}
QWidget#presetCard[checked="true"] {
    border: 1px solid @primary; background: @selected_bg;
}
QWidget#presetCard QRadioButton { font-weight: 600; background: transparent; }
QWidget#presetCard QLabel { background: transparent; }

/* ---------- Toast ---------- */
#toast { background: rgba(31, 36, 48, 242); border-radius: 10px; }
QLabel#toastLabel { color: #f1f3f8; background: transparent; }
QLabel#toastError { color: #ffb1a8; background: transparent; }

/* ---------- 其他 ---------- */
QToolTip {
    background: #24292f; color: #f1f3f8; border: none;
    padding: 6px 10px; border-radius: 4px; font-size: 12px;
}
QMenu {
    background: @menu_bg; border: 1px solid @border;
    color: @text;
    border-radius: 8px; padding: 5px;
}
QMenu::item { padding: 6px 24px; border-radius: 5px; }
QMenu::item:selected { background: @selected_bg; }
QMenu::separator { height: 1px; background: @grid_line; margin: 4px 8px; }

QSplitter::handle { background: @splitter; }
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical { height: 3px; }
QSplitter::handle:hover { background: @splitter_h; }

QTabBar::tab {
    padding: 8px 18px; color: @tab_text;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected { color: @primary; border-bottom: 2px solid @primary; }
QTabWidget::pane { border: 1px solid @border; border-radius: 8px; background: @card; }

QStatusBar {
    background: @statusbar_bg; border-top: 1px solid @statusbar_border;
    color: @text2;
}
QStatusBar QLabel { font-size: 12px; }
QLabel#taskStatus { color: @text2; padding: 2px 8px; background: transparent; }

/* 滚动容器视口透明：否则深色主题下露出调色板浅色底 */
QScrollArea { background: transparent; border: none; }
QScrollArea::viewport { background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QStackedWidget > QWidget { background: transparent; }
QTableCornerButton::corner { background: @header_bg; border: none; }
